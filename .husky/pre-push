# Incremental test run: only tests affected by pushed changes.
# Full suite still runs in CI.
pnpm --filter drop test:changed

# fallow audit gate: block on 'fail' verdict, tolerate JSON parse errors.
if command -v fallow >/dev/null 2>&1; then
  FALLOW_JSON=$(FALLOW_AUDIT_BASE=origin/rebuild fallow audit --format json --quiet --explain --gate-marker agent 2>/dev/null || echo '{"verdict":"error","error":true}')
  FALLOW_VERDICT=$(echo "${FALLOW_JSON}" | jq -r '.verdict // "error"' 2>/dev/null || echo "error")
  if [ "${FALLOW_VERDICT}" = "fail" ]; then
    printf '\n⚠️  fallow audit verdict: fail. Fix findings or use --no-verify.\n'
    exit 1
  elif [ "${FALLOW_VERDICT}" = "error" ]; then
    printf ':: fallow audit returned errors (non-blocking) — continuing\n'
  fi
else
  printf ':: fallow CLI not found — skipping audit gate\n'
fi

# Full test suite gate: verify no regressions before push.
pnpm --filter drop test

# OpenCodeReview gate: compare local branch against remote base.
# Runs only when ocr CLI is installed and remote base is fetchable.
# Detect base from upstream tracking. If upstream matches current branch
# (PR branch self-tracking) or unset, fall back to origin/rebuild.
CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
UPSTREAM="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
REMOTE_BASE="${UPSTREAM}"
if [ -z "${REMOTE_BASE}" ] || [ "${REMOTE_BASE##*/}" = "${CURRENT_BRANCH}" ]; then
  REMOTE_BASE="origin/rebuild"
fi

# Fetch unresolved PR review comments for agent consumption.
# Advisory only — warns but does not block push.
if command -v gh >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  REPO=$(git remote get-url origin | sed 's|.*github.com[:/]||;s|\.git$||')
  PR_NUMBER=$(gh pr list --repo "${REPO}" --head "${CURRENT_BRANCH}" --state open --json number --jq '.[0].number' 2>/dev/null)
  if [ -n "${PR_NUMBER}" ]; then
    OWNER="${REPO%%/*}"
    REPO_NAME="${REPO##*/}"
    # Fetch unresolved review threads across all pages (cursor-paginated).
    # Accumulates into a JSON array; exits loop when hasNextPage is false.
    ALL_UNRESOLVED='[]'
    CURSOR=''
    HAS_NEXT='true'
    while [ "${HAS_NEXT}" = 'true' ]; do
      if [ -z "${CURSOR}" ]; then
        PAGE_JSON=$(gh api graphql -f query='
          query($owner:String!, $repo:String!, $pr:Int!) {
            repository(owner:$owner, name:$repo) {
              pullRequest(number:$pr) {
                reviewThreads(first:100) {
                  nodes {
                    id isResolved isOutdated
                    comments(first:1) {
                      nodes { author { login } body path line }
                    }
                  }
                  pageInfo { hasNextPage endCursor }
                }
              }
            }
          }' -F owner="${OWNER}" -F repo="${REPO_NAME}" -F pr="${PR_NUMBER}" 2>&1) || {
          printf ':: Warning: gh API call failed (exit %d) — cannot check unresolved review threads.\n' "$?" >&2
          ALL_UNRESOLVED='error'
          break
        }
      else
        PAGE_JSON=$(gh api graphql -f query='
          query($owner:String!, $repo:String!, $pr:Int!, $cursor:String!) {
            repository(owner:$owner, name:$repo) {
              pullRequest(number:$pr) {
                reviewThreads(first:100, after:$cursor) {
                  nodes {
                    id isResolved isOutdated
                    comments(first:1) {
                      nodes { author { login } body path line }
                    }
                  }
                  pageInfo { hasNextPage endCursor }
                }
              }
            }
          }' -F owner="${OWNER}" -F repo="${REPO_NAME}" -F pr="${PR_NUMBER}" -F cursor="${CURSOR}" 2>&1) || {
          printf ':: Warning: gh API call failed on page (exit %d) — results may be incomplete.\n' "$?" >&2
          break
        }
      fi

      PAGE_UNRESOLVED=$(echo "${PAGE_JSON}" | jq -c '
        .data.repository.pullRequest.reviewThreads.nodes
        | map(select(.isResolved == false))
        | map({
            thread_id: .id,
            file: .comments.nodes[0].path,
            line: .comments.nodes[0].line,
            author: .comments.nodes[0].author.login,
            body_preview: (.comments.nodes[0].body | .[0:120]),
            is_outdated: .isOutdated
          })')
      ALL_UNRESOLVED=$(echo "${ALL_UNRESOLVED}" | jq -c ". + ${PAGE_UNRESOLVED}")
      HAS_NEXT=$(echo "${PAGE_JSON}" | jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage')
      CURSOR=$(echo "${PAGE_JSON}" | jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.endCursor')
    done

    if [ "${ALL_UNRESOLVED}" != 'error' ]; then
      UNRESOLVED_COUNT=$(echo "${ALL_UNRESOLVED}" | jq 'length')
      if [ "${UNRESOLVED_COUNT}" -gt 0 ]; then
        printf '\n⚠️  PR #%s has %s unresolved review thread(s). Address before push or use --no-verify.\n' \
          "${PR_NUMBER}" "${UNRESOLVED_COUNT}"
        # Output structured JSON for agent processing (line count is self-describing)
        printf '## PR_REVIEW_THREADS_START\n%s\n## PR_REVIEW_THREADS_END\n' "${ALL_UNRESOLVED}"
      fi
    fi
  fi
fi

if command -v ocr >/dev/null 2>&1 && git rev-parse --quiet --verify "${REMOTE_BASE}" >/dev/null 2>&1; then
  printf '\n:: Running OpenCodeReview against %s (blocking)...\n' "${REMOTE_BASE}"
  ocr review --from "${REMOTE_BASE}" --to HEAD --audience agent --exclude 'pnpm-lock.yaml,Cargo.lock' || {
    rc=$?
    printf '\n⚠️  OCR found issues (exit %d). Fix before pushing, or use --no-verify to skip.\n' "$rc"
    exit "$rc"
  }
elif ! command -v ocr >/dev/null 2>&1; then
  printf ':: ocr CLI not found — skipping OpenCodeReview gate\n'
else
  printf ':: Remote base %s not found locally — run `git fetch origin` first.\n' "${REMOTE_BASE}"
fi
